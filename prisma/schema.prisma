generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String               @id @default(cuid())
  name               String?
  email              String?              @unique
  emailVerified      DateTime?
  image              String?
  credits            Int                  @default(0)
  customApiKey       String?              @db.Text
  accounts           Account[]
  sessions           Session[]
  SocialPostCreation SocialPostCreation[]
  stripeCustomer     StripeCustomer?
  subscriptions      Subscription[]
  entitlements       Entitlement[]
  emailOutbox        EmailOutbox[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SocialPostCreation {
  id           String              @id @default(cuid())
  userId       String
  topic        String
  platform     String
  tone         String
  emoji        Boolean             @default(true)
  resultText   String?             @db.Text
  status       String              @default("processing")
  requestId    String?             @unique
  error        String?
  creditCost   Int                 @default(4)
  createdAt    DateTime            @default(now())
  User         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  language     String              @default("English")
  charLength   String              @default("Medium")
  includeTitle Boolean             @default(true)
  publications SocialPublication[]
}

model SocialPublication {
  id             String             @id @default(cuid())
  requestKey     String             @unique
  creationId     String
  creation       SocialPostCreation @relation(fields: [creationId], references: [id], onDelete: Cascade)
  platform       String
  status         String
  postUrl        String?
  error          String?
  approvedText   String?            @db.Text
  destinationRef String?
  providerPostId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([creationId, platform])
}

model StripeCustomer {
  id               String   @id @default(cuid())
  userId           String   @unique
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String    @id @default(cuid())
  userId               String
  stripeSubscriptionId String    @unique
  stripePriceId        String?
  status               String
  cancelAtPeriodEnd    Boolean   @default(false)
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Entitlement {
  id             String   @id @default(cuid())
  userId         String
  capability     String
  status         String
  subscriptionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, capability])
  @@index([subscriptionId])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  providerId  String
  type        String
  status      String
  attempts    Int       @default(0)
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, providerId])
  @@index([provider, status, receivedAt])
}

model EmailOutbox {
  id                String    @id @default(cuid())
  userId            String
  recipient         String
  trigger           String
  template          String
  deduplicationKey  String    @unique
  status            String    @default("pending")
  attempts          Int       @default(0)
  providerMessageId String?
  error             String?
  createdAt         DateTime  @default(now())
  sentAt            DateTime?
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, trigger])
}
